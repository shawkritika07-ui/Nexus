# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase project URL (server-side only).
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: Supabase service role key for secure server-side Storage & PostgreSQL operations (NEVER expose to frontend).
SUPABASE_SERVICE_ROLE_KEY=

# SUPABASE_STORAGE_BUCKET: Bucket name in Supabase Storage for eDNA datasets (default: edna-datasets).
SUPABASE_STORAGE_BUCKET=edna-datasets

# SUPABASE_EDGE_FUNCTION_URL: Optional deployed Supabase Edge Function URL for bioinformatics pipeline execution.
SUPABASE_EDGE_FUNCTION_URL=

# INITIAL_ADMIN_EMAIL: Optional override for bootstrapped admin email (defaults to workspace owner email if unset).
INITIAL_ADMIN_EMAIL=

# BLAST_PIPELINE_ENDPOINT: Optional external bioinformatics BLAST/SILVA/MIDORI service URL.
BLAST_PIPELINE_ENDPOINT=
